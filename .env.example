NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# docker-compose exposes postgres on 5433
DATABASE_URL=postgres://amrutam:amrutam@localhost:5433/amrutam
DB_POOL_MAX=20
REDIS_URL=redis://localhost:6379

# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# comma separated keyId:base64Key (32 bytes). Active key is used for new writes,
# old keys stay here until all rows are re-encrypted (see docs/security.md)
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=k1:REPLACE_WITH_32_BYTE_BASE64_KEY
ENCRYPTION_ACTIVE_KEY=k1

RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=120
# per IP, on login/register/refresh
AUTH_RATE_LIMIT_MAX=10

# doctors/admins must log in with MFA before writing prescriptions or using admin APIs
REQUIRE_STAFF_MFA=true
# HMAC secret shared with the payment provider for webhook signatures
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# how long a slot stays held while the patient pays
BOOKING_HOLD_MINUTES=10
# prescription PDFs are written here (swap for S3 in prod)
STORAGE_DIR=./storage
# optional bearer token for GET /metrics (leave empty when only reachable in-cluster)
METRICS_TOKEN=

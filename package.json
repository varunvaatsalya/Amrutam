{
  "name": "amrutam-telemed-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for Amrutam telemedicine - bookings, consultations, prescriptions",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
